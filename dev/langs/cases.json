{
    "description": "Cases every language runner checks besides the examples in dist/scalars.json, so all of them prove the same thing.",
    "normalize": [
        { "steps": ["trim", "lowercase", "remove_hyphens"], "in": " Ab-C ", "out": "abc" },
        { "steps": ["trim", "remove_spaces", "uppercase"], "in": "\tgb82 west　", "out": "GB82WEST" },
        { "steps": ["trim"], "in": "\u0085 x 　", "out": "x" },
        { "steps": ["trim"], "in": "﻿x\u001f", "out": "﻿x\u001f" },
        { "steps": ["lowercase"], "in": "İ", "out": "i̇" },
        { "steps": ["lowercase"], "in": "ΟΔΟΣ", "out": "οδος" },
        { "steps": ["uppercase"], "in": "straße", "out": "STRASSE" },
        { "steps": ["remove_spaces", "remove_hyphens"], "in": "+1 415-555 0123", "out": "+1415555 0123" }
    ],
    "lookup": [
        { "in": "phone", "out": "phone" },
        { "in": " Phone Number ", "out": "phone" },
        { "in": "phone-number", "out": "phone" },
        { "in": "Phone  -  Number", "out": "phone" },
        { "in": "　URL\t", "out": "uri" },
        { "in": "Money", "out": "decimal" },
        { "in": "﻿url", "out": null },
        { "in": "nothing like it", "out": null }
    ],
    "match": [
        { "type": "phone", "in": "+14155552671", "ok": true },
        { "type": "phone", "in": "+1٣٣٣", "ok": false },
        { "type": "media_type", "in": "text/html;\r\ncharset=utf-8", "ok": false },
        { "type": "char", "in": "😀", "ok": true },
        { "type": "char", "in": "ab", "ok": false },
        { "type": "media_type", "in": "text/html\n", "ok": false }
    ],
    "validate": [
        { "type": "email", "in": "  user@example.com ", "ok": true, "out": "user@example.com" },
        { "type": "email", "in": "user@", "ok": false },
        { "type": "uuid", "in": " F81D4FAE-7DEC-11D0-A765-00A0C91E6BF6 ", "ok": true, "out": "f81d4fae-7dec-11d0-a765-00a0c91e6bf6" },
        { "type": "iban", "in": " gb82 west 1234 5698 7654 32 ", "ok": true, "out": "GB82WEST12345698765432" },
        { "type": "country", "in": "ß", "ok": true, "out": "SS" },
        { "type": "phone", "in": "+14155552671\n", "ok": true, "out": "+14155552671" },
        { "type": "isbn", "in": "978-0-306-40615-7", "ok": true, "out": "9780306406157" },
        { "type": "iban", "in": "MT84 MALT 0110 0001 2345 MTLC AST0 01S", "ok": true, "out": "MT84MALT011000012345MTLCAST001S" },
        { "type": "char", "in": "é", "ok": true, "out": "é" },
        { "type": "char", "in": "😀", "ok": true, "out": "😀" },
        { "type": "int32", "in": 2147483647, "ok": true, "out": 2147483647 },
        { "type": "int32", "in": 2147483648, "ok": false },
        { "type": "int32", "in": 3.0, "ok": true, "out": 3 },
        { "type": "int32", "in": 3.5, "ok": false },
        { "type": "int32", "in": true, "ok": false, "dynamic": true },
        { "type": "email", "in": null, "ok": false, "dynamic": true },
        { "type": "email", "in": 123, "ok": false, "dynamic": true },
        { "type": "float64", "special": "NaN", "ok": false },
        { "type": "float64", "special": "Infinity", "ok": false },
        { "type": "boolean", "in": false, "ok": true, "out": false },
        { "type": "object", "in": [], "ok": false, "dynamic": true },
        { "type": "any", "in": [1, "two"], "ok": true, "out": [1, "two"] }
    ],
    "hostile": [
        { "type": "email", "prefix": "a@", "repeat": ".", "count": 200000, "suffix": "@", "ok": false },
        { "type": "slug", "prefix": "x", "repeat": " ", "count": 200000, "suffix": "x", "ok": false },
        { "type": "email", "prefix": "", "repeat": " ", "count": 200000, "suffix": "a@b.c", "ok": true },
        { "type": "json_pointer", "prefix": "", "repeat": "/a", "count": 100000, "suffix": "~2", "ok": false },
        { "type": "semver", "prefix": "1.0.0-", "repeat": "0.", "count": 100000, "suffix": "", "ok": false },
        { "type": "decimal", "prefix": "", "repeat": "1", "count": 200000, "suffix": ".5", "ok": true },
        { "type": "duration", "prefix": "P", "repeat": "1", "count": 200000, "suffix": "D", "ok": true },
        { "type": "hostname", "prefix": "", "repeat": "a.", "count": 100000, "suffix": "a", "ok": false },
        { "type": "base64", "prefix": "", "repeat": "QUJD", "count": 50000, "suffix": "!", "ok": false },
        { "type": "uuid", "prefix": "", "repeat": "f", "count": 200000, "suffix": "", "ok": false },
        { "type": "base64url", "prefix": "", "repeat": "A", "count": 200000, "suffix": "!", "ok": false },
        { "type": "css_color", "prefix": "rgb(", "repeat": "1 ", "count": 100000, "suffix": "", "ok": false },
        { "type": "css_color", "prefix": "rgb(", "repeat": "1 ", "count": 100000, "suffix": ")", "ok": true },
        { "type": "date_time", "prefix": "2026-08-16T14:30:00.", "repeat": "1", "count": 200000, "suffix": "Z", "ok": true },
        { "type": "date_time_local", "prefix": "2026-08-16T14:30:00.", "repeat": "1", "count": 200000, "suffix": "Z", "ok": false },
        { "type": "decimal128", "prefix": "-", "repeat": "1", "count": 200000, "suffix": ".", "ok": false },
        { "type": "doi", "prefix": "10.1000/", "repeat": "a", "count": 200000, "suffix": " ", "ok": false },
        { "type": "int64", "prefix": "", "repeat": "1", "count": 200000, "suffix": "x", "ok": false },
        { "type": "jwt", "prefix": "a.", "repeat": "b", "count": 200000, "suffix": ".c!", "ok": false },
        { "type": "media_range", "prefix": "text/html", "repeat": " ", "count": 200000, "suffix": ";q=1", "ok": true },
        { "type": "media_type", "prefix": "", "repeat": "a", "count": 200000, "suffix": "/", "ok": false },
        { "type": "relative_json_pointer", "prefix": "1", "repeat": "/a", "count": 100000, "suffix": "~", "ok": false },
        { "type": "sf_binary", "prefix": ":", "repeat": "QUJD", "count": 50000, "suffix": "=", "ok": false },
        { "type": "sf_string", "prefix": "", "repeat": "a", "count": 200000, "suffix": "\u007f", "ok": false },
        { "type": "sf_token", "prefix": "a", "repeat": "a:", "count": 100000, "suffix": " ", "ok": false },
        { "type": "time", "prefix": "14:30:00.", "repeat": "1", "count": 200000, "suffix": "+05:3", "ok": false },
        { "type": "time_local", "prefix": "14:30:00.", "repeat": "1", "count": 200000, "suffix": "", "ok": true },
        { "type": "timezone", "prefix": "America/", "repeat": "a", "count": 200000, "suffix": "/", "ok": false },
        { "type": "uint64", "prefix": "", "repeat": "9", "count": 200000, "suffix": "", "ok": true },
        { "type": "wikidata_qid", "prefix": "Q1", "repeat": "0", "count": 200000, "suffix": "!", "ok": false }
    ]
}
