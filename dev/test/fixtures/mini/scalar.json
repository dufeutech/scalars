{
    "$schema": "../../../../schema/scalar.schema.json",
    "version": "0.0.0",
    "$defs": {
        "docs": {
            "rfc3986": "https://datatracker.ietf.org/doc/html/rfc3986",
            "rfc9562": "https://datatracker.ietf.org/doc/html/rfc9562"
        }
    },
    "string": { "level": "core", "type": "string", "label": "Text" },
    "_token": { "abstract": true, "base": "string" },
    "slug": { "base": "_token", "level": "core", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "standard": "RFC 3986 (path segment)", "docs": "rfc3986", "anchor": "#section-3.3" },
    "uuid": { "base": "_token", "level": "core", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "standard": "RFC 9562", "docs": "rfc9562" },
    "uuid_v7": { "base": "uuid", "level": "advanced", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "jwt_like": { "base": "uuid", "level": "advanced", "format": null, "alternative": "string" },
    "quiet": { "base": "string", "level": "advanced" }
}
