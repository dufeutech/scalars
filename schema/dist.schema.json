{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://scalars.dev/schema/dist.schema.json",
    "title": "Scalar types (resolved release file)",
    "description": "dist/scalars.json: every type fully resolved. Nothing here needs code to read: no inheritance, no references.",
    "type": "object",
    "required": ["version", "$meta", "types"],
    "properties": {
        "$schema": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "$meta": {
            "type": "object",
            "required": ["lookup", "normalize_steps", "params", "postgres_attrs", "templates"],
            "properties": {
                "lookup": { "type": "string", "description": "How to find a type from a word a person typed." },
                "normalize_steps": {
                    "type": "object",
                    "description": "Every cleanup step a type's normalize list may name, with its exact meaning.",
                    "additionalProperties": { "type": "string" }
                },
                "params": {
                    "type": "object",
                    "description": "Every setting a field can take (length, precision, values, ...), defined once. A type's params lists the ones it accepts; nullable applies to every type.",
                    "additionalProperties": { "type": "object", "required": ["type", "description"] }
                },
                "postgres_attrs": {
                    "type": "object",
                    "description": "Settings only Postgres has, defined once. A type's postgres.attr lists the ones it accepts; collation applies to every text and varchar column.",
                    "additionalProperties": { "type": "object", "required": ["description", "sql"] }
                },
                "templates": { "type": "object", "description": "Placeholders used in generated text, like {column} in postgres.check." }
            },
            "additionalProperties": false
        },
        "types": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
            "additionalProperties": { "$ref": "#/$defs/type" }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "type": {
            "type": "object",
            "required": ["name", "primitive", "level", "category", "label", "hint", "error", "examples", "html", "postgres"],
            "properties": {
                "name": { "type": "string" },
                "primitive": { "type": "string", "description": "The basic type this one is built from." },
                "level": { "enum": ["core", "advanced", "domain"] },
                "category": { "type": "string" },
                "alternative": { "type": "string", "description": "For advanced and domain types: the core type to use instead." },
                "label": { "type": "string" },
                "hint": { "type": "string" },
                "error": { "type": "string" },
                "aliases": { "type": "array", "items": { "type": "string" } },
                "type": { "enum": ["string", "integer", "number", "boolean", "object", "array"] },
                "format": { "type": "string" },
                "pattern": { "type": "string", "description": "Anchored ^...$ and limited to a subset every common engine reads the same (Go, Python, Rust, JS, Postgres): no \\d \\s \\w, no '.', no lookaround or backreferences. In Python use re.fullmatch: '$' alone also matches before a trailing newline." },
                "minLength": { "type": "integer", "description": "Fewest characters, counted as Unicode code points." },
                "maxLength": { "type": "integer", "description": "Most characters, counted as Unicode code points." },
                "minimum": { "type": "number" },
                "maximum": { "type": "number" },
                "contentEncoding": { "type": "string" },
                "normalize": { "type": "array", "items": { "type": "string" } },
                "params": { "type": "array", "items": { "type": "string" }, "description": "Names from $meta.params that a field of this type can set." },
                "examples": {
                    "type": "object",
                    "required": ["valid"],
                    "properties": {
                        "valid": { "type": "array", "minItems": 1 },
                        "invalid": { "type": "array" },
                        "db_invalid": { "type": "array" }
                    },
                    "additionalProperties": false
                },
                "standard": { "type": "string" },
                "docs_link": { "type": "string" },
                "details": { "type": "string" },
                "html": {
                    "type": "object",
                    "properties": {
                        "element": { "enum": ["input", "textarea", "select"] },
                        "attrs": { "type": "object", "additionalProperties": { "type": "string" } },
                        "options": { "type": "object" },
                        "note": { "type": "string" }
                    },
                    "required": ["element"],
                    "additionalProperties": false
                },
                "postgres": {
                    "type": "object",
                    "properties": {
                        "type": { "type": "string" },
                        "attr": { "type": "array", "items": { "type": "string" }, "description": "Names from $meta.postgres_attrs." },
                        "note": { "type": "string" },
                        "check": { "type": "string" },
                        "docs_link": { "type": "string" }
                    },
                    "required": ["type"],
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    }
}
