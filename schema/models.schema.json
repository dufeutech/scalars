{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://scalars.dev/schema/models.schema.json",
    "title": "Models file",
    "description": "A models file: domain, then model, then field. Checks shape and names only; which settings a type takes is checked when the file is loaded.",
    "type": "object",
    "propertyNames": {
        "oneOf": [
            { "$ref": "#/$defs/name" },
            { "const": "$schema" }
        ]
    },
    "properties": {
        "$schema": { "type": "string" }
    },
    "additionalProperties": { "$ref": "#/$defs/domain" },
    "$defs": {
        "name": {
            "description": "Lowercase letters, digits and underscores, starting with a letter.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
        },
        "reference": {
            "description": "A type, a model, or a field of a model: [domain:]name[.field].",
            "type": "string",
            "pattern": "^(?:([a-z][a-z0-9_]*):)?([a-z][a-z0-9_]*)(?:\\.([a-z][a-z0-9_]*))?$"
        },
        "domain": {
            "description": "Models by name.",
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/name" },
            "additionalProperties": { "$ref": "#/$defs/model" }
        },
        "model": {
            "description": "Fields by name. An entity (with an implicit id, a uuid v7) unless \"$value\" is true; only a value can be embedded.",
            "type": "object",
            "propertyNames": {
                "oneOf": [
                    { "$ref": "#/$defs/name" },
                    { "const": "$value" }
                ]
            },
            "properties": {
                "$value": { "type": "boolean" }
            },
            "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "field": {
            "description": "A reference, or an object with a type (a reference) and its settings.",
            "oneOf": [
                { "$ref": "#/$defs/reference" },
                {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                        "type": { "$ref": "#/$defs/reference" },
                        "fractional_seconds": { "type": "integer", "minimum": 0, "maximum": 6 },
                        "items": { "$ref": "#/$defs/field" },
                        "length": { "type": "integer", "minimum": 1, "maximum": 10485760 },
                        "many": { "type": "boolean", "description": "A link: true for many-to-many, the value a list of ids." },
                        "nullable": { "type": "boolean" },
                        "one": { "type": "boolean", "description": "A link: true for one-to-one." },
                        "precision": { "type": "integer", "minimum": 1, "maximum": 1000 },
                        "scale": { "type": "integer", "minimum": -1000, "maximum": 1000 },
                        "to": { "$ref": "#/$defs/reference", "description": "A link: the entity it points at, [domain:]model." },
                        "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "maxLength": 63, "description": "At most 63 bytes as UTF-8; maxLength counts characters, so loading checks the bytes." } }
                    },
                    "additionalProperties": false
                }
            ]
        }
    }
}
