{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://scalars.dev/schema/scalar.schema.json",
    "title": "Scalar types (source)",
    "description": "The editable source of every scalar type. Keys other than $schema, version and $defs are type names.",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "$defs": {
            "type": "object",
            "properties": {
                "docs": {
                    "type": "object",
                    "description": "Documentation links by id. A type points at one with docs (+ optional anchor).",
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://[^#]*$"
                    }
                },
                "errors": {
                    "type": "object",
                    "description": "The message template of each error code a models engine reports. {name} is replaced by the problem's param of that name. A code with no template (a reason from $meta.reasons, other than too_long) takes the type's error as its message.",
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "reasons": {
                    "type": "object",
                    "description": "Why a validate failed, in the order the single pass checks. Emitted as $meta.reasons.",
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "params": {
                    "type": "object",
                    "description": "Settings a field of a type can take (like a length), defined once. A type lists the ones it accepts in params.",
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                        "type": "object",
                        "required": ["type", "description", "level"],
                        "properties": {
                            "type": { "enum": ["integer", "boolean", "array", "string"] },
                            "minimum": { "type": "integer" },
                            "maximum": { "type": "integer" },
                            "minItems": { "type": "integer" },
                            "maxItemBytes": { "type": "integer", "minimum": 1, "description": "Most bytes, as UTF-8, each entry of a list setting may have." },
                            "default": {},
                            "level": { "enum": ["core", "advanced"] },
                            "description": { "type": "string" }
                        },
                        "additionalProperties": false
                    }
                }
            }
        }
    },
    "required": [
        "version"
    ],
    "propertyNames": {
        "pattern": "^(\\$schema|\\$defs|version|_?[a-z][a-z0-9_]*)$"
    },
    "additionalProperties": {
        "$ref": "#/$defs/type"
    },
    "$defs": {
        "normalize_step": {
            "description": "One cleanup step, applied to the raw input before validation, in the order listed.",
            "oneOf": [
                {
                    "const": "trim",
                    "description": "Remove leading and trailing Unicode White_Space: U+0009-U+000D, U+0020, U+0085, U+00A0, U+1680, U+2000-U+200A, U+2028, U+2029, U+202F, U+205F, U+3000."
                },
                {
                    "const": "lowercase",
                    "description": "Unicode default lowercase mapping, locale-independent: the full mapping, so U+0130 becomes i + U+0307 and a final capital sigma becomes U+03C2. In Go use golang.org/x/text/cases, not strings.ToLower."
                },
                {
                    "const": "uppercase",
                    "description": "Unicode default uppercase mapping, locale-independent: the full mapping, so U+00DF becomes SS. In Go use golang.org/x/text/cases, not strings.ToUpper."
                },
                {
                    "const": "remove_spaces",
                    "description": "Remove every U+0020 SPACE."
                },
                {
                    "const": "remove_hyphens",
                    "description": "Remove every U+002D HYPHEN-MINUS."
                }
            ]
        },
        "check": {
            "description": "One rule beyond the pattern, run on the normalized value after the pattern matched.",
            "oneOf": [
                {
                    "const": "gs1_mod10",
                    "description": "GS1 check digit. Digits only. From the right, the last digit has weight 1, then weights alternate 3, 1, 3, ...; the weighted sum is a multiple of 10."
                },
                {
                    "const": "iso7064_mod97_10",
                    "description": "ISO 7064 MOD 97-10. Read left to right with r = 0: a digit d sets r = (r * 10 + d) mod 97, a letter A-Z (A = 10 ... Z = 35) sets r = (r * 100 + value) mod 97; valid when r = 1."
                },
                {
                    "const": "iban",
                    "description": "ISO 13616: move the first four characters to the end, then iso7064_mod97_10."
                },
                {
                    "const": "isbn",
                    "description": "ISO 2108: 13 characters use gs1_mod10. 10 characters: the value at position i (0-based) times (10 - i), with X or x = 10; the sum is a multiple of 11."
                },
                {
                    "const": "iso7064_mod11_2",
                    "description": "ISO 7064 MOD 11-2 (ORCID, ISNI). Skip hyphens. With t = 0, for each digit but the last, t = ((t + digit) * 2) mod 11; the check value is (12 - t mod 11) mod 11, written X when 10; valid when the last character is the check value."
                },
                {
                    "const": "int64_range",
                    "description": "An optional - then digits, leading zeros ignored, between -9223372036854775808 and 9223372036854775807. Compare digit by digit, not by converting: drop leading zeros, then fewer digits is smaller and equal counts compare as text."
                },
                {
                    "const": "uint64_range",
                    "description": "Digits, leading zeros ignored, at most 18446744073709551615. Compared as int64_range is."
                }
            ]
        },
        "nullable_string": {
            "type": [
                "string",
                "null"
            ]
        },
        "nullable_number": {
            "type": [
                "number",
                "null"
            ]
        },
        "examples": {
            "type": "array"
        },
        "type": {
            "type": "object",
            "properties": {
                "base": {
                    "type": "string",
                    "description": "The type this one is built on. Inherits type, format, pattern, minimum, maximum, contentEncoding, normalize and check; null in a child deletes an inherited value."
                },
                "abstract": {
                    "const": true,
                    "description": "A building block only; never appears in dist/."
                },
                "level": {
                    "enum": [
                        "core",
                        "advanced",
                        "domain"
                    ]
                },
                "alternative": {
                    "type": "string",
                    "description": "The core type to use instead. Defaults to the nearest core ancestor; write it only when that is wrong."
                },
                "label": {
                    "type": "string",
                    "maxLength": 32
                },
                "hint": {
                    "type": "string",
                    "maxLength": 60
                },
                "error": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "\\.$"
                },
                "aliases": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                    }
                },
                "type": {
                    "enum": [
                        "string",
                        "integer",
                        "number",
                        "boolean",
                        "object",
                        "array",
                        null
                    ]
                },
                "format": {
                    "$ref": "#/$defs/nullable_string"
                },
                "pattern": {
                    "$ref": "#/$defs/nullable_string"
                },
                "params": {
                    "type": "array",
                    "description": "Names from $defs.params this type accepts. Not inherited: list them on every type that takes them.",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string" }
                },
                "minLength": {
                    "type": ["integer", "null"],
                    "minimum": 0
                },
                "maxLength": {
                    "type": ["integer", "null"],
                    "minimum": 1
                },
                "minimum": {
                    "$ref": "#/$defs/nullable_number"
                },
                "maximum": {
                    "$ref": "#/$defs/nullable_number"
                },
                "contentEncoding": {
                    "$ref": "#/$defs/nullable_string"
                },
                "normalize": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "items": {
                        "$ref": "#/$defs/normalize_step"
                    }
                },
                "check": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/check"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "examples": {
                    "type": "object",
                    "properties": {
                        "valid": {
                            "type": "array",
                            "minItems": 1
                        },
                        "invalid": {
                            "$ref": "#/$defs/examples"
                        },
                        "db_invalid": {
                            "$ref": "#/$defs/examples"
                        },
                        "check_invalid": {
                            "$ref": "#/$defs/examples"
                        }
                    },
                    "required": [
                        "valid"
                    ],
                    "additionalProperties": false
                },
                "standard": {
                    "type": "string",
                    "description": "The standard this type follows, as plain text."
                },
                "docs": {
                    "type": "string",
                    "description": "An id in $defs.docs; the docs_link is that URL plus anchor."
                },
                "anchor": {
                    "type": "string",
                    "pattern": "^#"
                },
                "details": {
                    "type": "string",
                    "description": "The expert explanation."
                }
            },
            "additionalProperties": false,
            "if": {
                "required": [
                    "abstract"
                ]
            },
            "then": {},
            "else": {
                "required": [
                    "level"
                ]
            }
        }
    }
}
