{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://scalars.dev/schema/scalar.schema.json",
    "title": "Scalar types (source)",
    "description": "The editable source of every scalar type. Keys other than $schema, version and $defs are type names.",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "$defs": {
            "type": "object",
            "properties": {
                "docs": {
                    "type": "object",
                    "description": "Documentation links by id. A type points at one with docs (+ optional anchor).",
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://[^#]*$"
                    }
                },
                "params": {
                    "type": "object",
                    "description": "Settings a field of a type can take (like a length), defined once. A type lists the ones it accepts in params.",
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                        "type": "object",
                        "required": ["type", "description", "level"],
                        "properties": {
                            "type": { "enum": ["integer", "boolean", "array", "string"] },
                            "minimum": { "type": "integer" },
                            "maximum": { "type": "integer" },
                            "minItems": { "type": "integer" },
                            "default": {},
                            "level": { "enum": ["core", "advanced"] },
                            "description": { "type": "string" }
                        },
                        "additionalProperties": false
                    }
                }
            }
        }
    },
    "required": [
        "version"
    ],
    "propertyNames": {
        "pattern": "^(\\$schema|\\$defs|version|_?[a-z][a-z0-9_]*)$"
    },
    "additionalProperties": {
        "$ref": "#/$defs/type"
    },
    "$defs": {
        "normalize_step": {
            "description": "One cleanup step, applied to the raw input before validation, in the order listed.",
            "oneOf": [
                {
                    "const": "trim",
                    "description": "Remove leading and trailing Unicode White_Space: U+0009-U+000D, U+0020, U+0085, U+00A0, U+1680, U+2000-U+200A, U+2028, U+2029, U+202F, U+205F, U+3000."
                },
                {
                    "const": "lowercase",
                    "description": "Unicode default lowercase mapping, locale-independent."
                },
                {
                    "const": "uppercase",
                    "description": "Unicode default uppercase mapping, locale-independent."
                },
                {
                    "const": "remove_spaces",
                    "description": "Remove every U+0020 SPACE."
                },
                {
                    "const": "remove_hyphens",
                    "description": "Remove every U+002D HYPHEN-MINUS."
                }
            ]
        },
        "nullable_string": {
            "type": [
                "string",
                "null"
            ]
        },
        "nullable_number": {
            "type": [
                "number",
                "null"
            ]
        },
        "examples": {
            "type": "array"
        },
        "type": {
            "type": "object",
            "properties": {
                "base": {
                    "type": "string",
                    "description": "The type this one is built on. Inherits type, format, pattern, minimum, maximum, contentEncoding and normalize; null in a child deletes an inherited value."
                },
                "abstract": {
                    "const": true,
                    "description": "A building block only; never appears in dist/."
                },
                "level": {
                    "enum": [
                        "core",
                        "advanced",
                        "domain"
                    ]
                },
                "category": {
                    "enum": [
                        "primitive",
                        "structure",
                        "temporal",
                        "identity",
                        "technical",
                        "business"
                    ]
                },
                "alternative": {
                    "type": "string",
                    "description": "The core type to use instead. Defaults to the nearest core ancestor; write it only when that is wrong."
                },
                "label": {
                    "type": "string",
                    "maxLength": 32
                },
                "hint": {
                    "type": "string",
                    "maxLength": 60
                },
                "error": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "\\.$"
                },
                "aliases": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                    }
                },
                "type": {
                    "enum": [
                        "string",
                        "integer",
                        "number",
                        "boolean",
                        "object",
                        "array",
                        null
                    ]
                },
                "format": {
                    "$ref": "#/$defs/nullable_string"
                },
                "pattern": {
                    "$ref": "#/$defs/nullable_string"
                },
                "params": {
                    "type": "array",
                    "description": "Names from $defs.params this type accepts. Not inherited: list them on every type that takes them.",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string" }
                },
                "minLength": {
                    "type": ["integer", "null"],
                    "minimum": 0
                },
                "maxLength": {
                    "type": ["integer", "null"],
                    "minimum": 1
                },
                "minimum": {
                    "$ref": "#/$defs/nullable_number"
                },
                "maximum": {
                    "$ref": "#/$defs/nullable_number"
                },
                "contentEncoding": {
                    "$ref": "#/$defs/nullable_string"
                },
                "normalize": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "items": {
                        "$ref": "#/$defs/normalize_step"
                    }
                },
                "examples": {
                    "type": "object",
                    "properties": {
                        "valid": {
                            "type": "array",
                            "minItems": 1
                        },
                        "invalid": {
                            "$ref": "#/$defs/examples"
                        },
                        "db_invalid": {
                            "$ref": "#/$defs/examples"
                        }
                    },
                    "required": [
                        "valid"
                    ],
                    "additionalProperties": false
                },
                "standard": {
                    "type": "string",
                    "description": "The standard this type follows, as plain text."
                },
                "docs": {
                    "type": "string",
                    "description": "An id in $defs.docs; the docs_link is that URL plus anchor."
                },
                "anchor": {
                    "type": "string",
                    "pattern": "^#"
                },
                "details": {
                    "type": "string",
                    "description": "The expert explanation."
                }
            },
            "additionalProperties": false,
            "if": {
                "required": [
                    "abstract"
                ]
            },
            "then": {},
            "else": {
                "required": [
                    "level",
                    "category"
                ]
            }
        }
    }
}
